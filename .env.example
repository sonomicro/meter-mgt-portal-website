# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Notehub.io Configuration (Required for device management)
VITE_NOTEHUB_PROJECT_UID=app:12345678-1234-1234-1234-123456789abc
VITE_NOTEHUB_AUTH_TOKEN=your_bearer_token_here

# Optional: Webhook security
NOTEHUB_WEBHOOK_SECRET=your_webhook_secret_key